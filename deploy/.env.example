# =============================================================
# Docker Compose 的环境变量
# =============================================================
#
# 用法：
#     cd deploy
#     Copy-Item .env.example .env
#     # 填好下面标了「必须修改」的几项
#     docker compose up -d --build
#
# compose 会自动读取**同目录下**的 .env 文件。
# 这个文件已被 .gitignore 忽略，不会提交。
# =============================================================

# ---------------------------------------------------------------
# 数据库密码
# 【必须修改】容器建库时用它，之后改这个值不会改已存在的库密码，
# 要同时改密码得进容器 ALTER USER。
# ---------------------------------------------------------------
DB_PASSWORD=change-me-please

# ---------------------------------------------------------------
# JWT 签名密钥
# 【必须修改】泄露等于任何人都能伪造登录态。
# 生成一个：openssl rand -hex 32
# 或者 PowerShell：-join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
# ---------------------------------------------------------------
JWT_SECRET=change-me-please-at-least-32-chars

# ---------------------------------------------------------------
# Go 服务与 AI 服务之间的内部令牌
# 【必须修改】AI 服务用它拒绝非本服务发来的请求。
# 不用太复杂（只在内网用），但不能是默认值。
# ---------------------------------------------------------------
AI_INTERNAL_TOKEN=change-me-please

# ---------------------------------------------------------------
# 前端对宿主机暴露的端口
# 80 需要管理员权限；被占用时改成 8080 之类
# ---------------------------------------------------------------
WEB_PORT=80

# ---------------------------------------------------------------
# Cookie 是否只在 HTTPS 下传输
#
# 【纯 HTTP 本地访问必须留 false】
# 设成 true 时浏览器会因为 Secure 属性拒绝存储 refresh cookie，
# 表现是「能登录，但一刷新就掉登录」。
# 只有真的配了 HTTPS（域名 + 证书）才改成 true。
# ---------------------------------------------------------------
COOKIE_SECURE=false

# ---------------------------------------------------------------
# 允许的跨域来源
# 同源访问（nginx 反代）时用不到，留默认即可。
# 想直接用 http://<服务器IP>:8080 调 API 调试时，把那个地址加进来。
# ---------------------------------------------------------------
CORS_ORIGINS=http://localhost

# ---------------------------------------------------------------
# OAuth 回调后跳回哪里
# 局域网访问时改成 http://192.168.x.x
# ---------------------------------------------------------------
FRONTEND_URL=http://localhost

# ---------------------------------------------------------------
# 对话模型（AI 讲解功能）
#
# 用的是 OpenCode Go 订阅的端点。没有的话留空 ——
# 只是「AI 讲解」不可用，其他功能都正常。
#
# 【注意】CHAT_API_KEY 是 OpenCode Go 的 key，
# 不同机器的 key 不一样，换机器要重新取。
# 本地路径：~/.local/share/opencode/auth.json 里的 opencode-go.key
# ---------------------------------------------------------------
CHAT_API_KEY=
CHAT_BASE_URL=https://opencode.ai/zen/go/v1
CHAT_MODEL=space-bunny-free
CHAT_USER_AGENT=leetnote-ai/0.1.0
CHAT_SESSION_HEADER=x-opencode-session

# ---------------------------------------------------------------
# Embedding（相似题推荐）
# 留空则用内置的本地哈希向量器 —— 不需要外部服务，离线可用。
# 想换成真实语义向量时填一个 OpenAI 兼容的 embedding 服务。
# 【注意】换模型后已有向量不在同一向量空间，需要重新生成。
# ---------------------------------------------------------------
EMBEDDING_MODEL=
EMBEDDING_DIM=1536
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1

# ---------------------------------------------------------------
# GitHub 登录（可留空，留空即关闭该登录方式）
# ---------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost/api/v1/auth/github/callback
