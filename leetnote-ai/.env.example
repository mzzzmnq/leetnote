# ===== leetnote-ai 环境变量 =====
# 复制为 .env 后按需修改（.env 已在 .gitignore 里，不会被提交）

APP_ENV=development
HTTP_PORT=8000

# 用 libpq 格式（注意不是 postgresql+psycopg://），与 Go 服务连同一个库
DATABASE_URL=postgresql://leetnote:leetnote@localhost:5432/leetnote

# ============ Embedding（相似题检索用）============
# 【留空则使用本地哈希向量器】—— 它能跑通整条链路，但不理解语义，
# 只适合开发调试。真正使用请填下面的配置。
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=

# 必须与 note_embeddings.embedding 的列定义一致（当前是 vector(1536)）。
# 换成维度不同的模型（如 bge-m3 是 1024）需要先改表结构。
EMBEDDING_DIM=1536

# ============ 对话模型（LLM 解法讲解）============
#
# 默认配置指向 **OpenCode Go**（$10/月的订阅，含多种开源编码模型）。
# Key 获取方式：OpenCode 里执行 /connect → 选 OpenCode Go → 粘贴 API Key。
# 本机已登录的话，Key 就在 ~/.local/share/opencode/auth.json 的 opencode-go.key
#
# 也可换成任何 OpenAI 兼容服务（硅基流动 / 智谱 / 通义 / OpenAI），
# 此时把下面两个 OpenCode 专用的头留空即可。
CHAT_API_KEY=
CHAT_BASE_URL=https://opencode.ai/zen/go/v1
CHAT_MODEL=space-bunny-free

# OpenCode Go 对第三方客户端的两条硬性要求（不带会 503）：
#   1. 用【自己的】User-Agent 标识，不能是通用 SDK / HTTP 库的名字
#   2. 每个会话带稳定的会话 ID 头，用于路由优化与 prompt 缓存
# 参考 https://opencode.ai/docs/go/#where-can-i-use-it
CHAT_USER_AGENT=leetnote-ai/0.1.0
CHAT_SESSION_HEADER=x-opencode-session

# ===== 服务间鉴权 =====
# 本服务只应由 Go 服务调用。生产环境务必换成随机值：
#   openssl rand -hex 32
INTERNAL_API_TOKEN=dev-internal-token-change-me
