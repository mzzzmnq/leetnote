# ===== leetnote-ai 环境变量 =====
# 复制为 .env 后按需修改（.env 已在 .gitignore 里，不会被提交）

APP_ENV=development
HTTP_PORT=8000

# 用 libpq 格式（注意不是 postgresql+psycopg://），与 Go 服务连同一个库
DATABASE_URL=postgresql://leetnote:leetnote@localhost:5432/leetnote

# ============ Embedding（相似题检索用）============
# 【留空则使用本地哈希向量器】—— 它能跑通整条链路，但不理解语义，
# 只适合开发调试。真正使用请填下面的配置。
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=

# 必须与 note_embeddings.embedding 的列定义一致（当前是 vector(1536)）。
# 换成维度不同的模型（如 bge-m3 是 1024）需要先改表结构。
EMBEDDING_DIM=1536

# ============ 对话模型（LLM 解法讲解）============
#
# 默认指向 **智谱 GLM-4.7-Flash** —— 永久免费、国内直连、编码/中文都强。
# 申请 Key：https://open.bigmodel.cn/ （注册并实名后，控制台创建 API Key）
CHAT_API_KEY=
CHAT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
CHAT_MODEL=glm-4.7-flash
CHAT_USER_AGENT=leetnote-ai/0.1.0
CHAT_SESSION_HEADER=

# ---- 想改用 OpenCode Go 订阅（含自有免费模型）时，把上面三行换成：----
#   CHAT_BASE_URL=https://opencode.ai/zen/go/v1
#   CHAT_MODEL=longcat-2.5-preview-free      # 免费；或 deepseek-v4.1-flash 等
#   CHAT_SESSION_HEADER=x-opencode-session   # 不带会 503
# 且 CHAT_API_KEY 可留空 —— 代码会自动从本机 opencode 凭据库读取。
# （仅当 base_url 指向 opencode.ai 时才会自动发现，避免把该 key 发到别的平台。）

# ===== 服务间鉴权 =====
# 本服务只应由 Go 服务调用。生产环境务必换成随机值：
#   openssl rand -hex 32
INTERNAL_API_TOKEN=dev-internal-token-change-me
