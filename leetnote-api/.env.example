# ===== leetnote-api (Go) 环境变量示例 =====
# 复制为 .env 后按需修改

APP_ENV=development
HTTP_PORT=8080
GRPC_PORT=9091

# 本地便携版 PostgreSQL
DATABASE_URL=postgres://leetnote:leetnote@localhost:5432/leetnote?sslmode=disable

# Redis（阶段二再装）
REDIS_ADDR=localhost:6379

# JWT —— 生产环境务必替换：openssl rand -hex 32
JWT_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# 调用 leetnote-ai 的 gRPC 地址
AI_GRPC_ADDR=localhost:9090

# 允许跨域的前端地址
CORS_ORIGINS=http://localhost:5173
